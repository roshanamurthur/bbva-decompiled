<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tx_container"
        android:padding="12dp"
        android:layout_width="382dp"
        android:layout_height="156dp">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/nav_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/MPPPinModuleNavigationBar.Title"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/digits_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="21dp"
            android:layout_weight="1"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/amount"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/MPPPinModulePinPad.Amount"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/details"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/MPPPinModulePinPad.Details"/>
    </LinearLayout>
    <View
        android:id="@+id/spacer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_below="@+id/tx_container"/>
    <FrameLayout
        android:id="@+id/pin_pad_container"
        android:saveEnabled="false"
        android:layout_width="382dp"
        android:layout_height="438dp"
        android:layout_below="@+id/spacer">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</RelativeLayout>
