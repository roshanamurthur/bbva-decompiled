<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:tint="?attr/form.selector.border.default"
            android:shape="oval">
            <size
                android:height="32dp"
                android:width="32dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape
            android:tint="?attr/form.selector.background.default"
            android:shape="oval">
            <size
                android:height="32dp"
                android:width="32dp"/>
        </shape>
    </item>
</layer-list>
