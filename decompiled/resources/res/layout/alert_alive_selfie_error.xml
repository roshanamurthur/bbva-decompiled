<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/vd_photo_transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/vd_photo_rectangle_helper"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/vd_photo_alert_title_size"
            android:gravity="center_horizontal"
            android:id="@+id/alert_error_title"
            android:background="@color/vd_photo_transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"/>
        <View
            android:id="@+id/alert_error_title_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>
        <TextView
            android:id="@+id/alert_error_description"
            android:background="@color/vd_photo_transparent"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/alert_error_step1"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/alert_error_step1_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="100dp"/>
        <TextView
            android:id="@+id/alert_error_step2"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/alert_error_step2_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="100dp"/>
        <TextView
            android:id="@+id/alert_error_step3"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/alert_error_step3_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="100dp"/>
        <Button
            android:id="@+id/alert_error_button"
            android:background="@drawable/vd_photo_alert_error_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"/>
    </LinearLayout>
</LinearLayout>
