<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="level:confirmation_view;styles:view_background"
    android:background="#eeeeee"
    android:paddingTop="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/transaction_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <ScrollView
        android:id="@+id/ext_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/transaction_content">
        <TextView
            android:textSize="35sp"
            android:textStyle="normal"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/asm_presence_text_view"
            android:tag="styles:title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:scrollHorizontally="true"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:theme="@style/NNLAuthorizeButtonStyle"
            android:textSize="22sp"
            android:textColor="@color/nnl_button_text_color"
            android:id="@+id/asm_presence_authorize_button"
            android:tag="styles:main_button;strings:authorize_button"
            android:background="@drawable/nnl_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_asmsdk_click_to_authorize"
            android:layout_weight="1"
            android:textAllCaps="false"
            style="@style/NNLAuthorizeButtonStyle"/>
        <Button
            android:theme="@style/NNLDeclineButtonStyle"
            android:textSize="22sp"
            android:textColor="@color/nnl_button_text_color"
            android:id="@+id/asm_presence_decline_button"
            android:tag="styles:basic_button;strings:decline_button"
            android:background="@drawable/nnl_button_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_asmsdk_click_to_decline"
            android:layout_weight="1"
            android:textAllCaps="false"
            style="@style/NNLDeclineButtonStyle"/>
    </LinearLayout>
</RelativeLayout>
