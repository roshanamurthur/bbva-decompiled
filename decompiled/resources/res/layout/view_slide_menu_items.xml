<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="?attr/cellsMenuStyle"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bbva.ui.component.menu.view.recycler.item.ShadowView
        android:id="@+id/shadowView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bbva.ui.component.menu.view.recycler.MenuRecyclerView
        android:layout_gravity="center"
        android:id="@+id/recyclerView"
        android:fadingEdgeLength="80dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="vertical"/>
    <com.bbva.ui.component.menu.view.recycler.item.HeaderMenuItemView
        android:theme="?attr/cellsMenu_headerItemStyle"
        android:id="@+id/headerMenuItemView"
        android:background="?attr/cellsMenuItem_background"
        android:paddingLeft="32dp"
        android:paddingRight="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/cellsMenu_headerItemTopMargin"
        app:behavior_space="?attr/cellsMenu_headerItemBottomMargin"
        app:layout_anchor="@+id/recyclerView"
        app:layout_behavior="com.bbva.ui.component.menu.view.recycler.item.HeaderMenuItemView$Behavior"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/footerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        android:layout_marginBottom="32dp">
        <include
            android:id="@+id/footerMenuInfoView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_info_menu_item"/>
        <com.bbva.ui.component.menu.view.recycler.item.MenuItemView
            android:theme="?attr/cellsMenu_footerItemStyle"
            android:id="@+id/footerMenuItemView"
            android:background="?attr/cellsMenuItem_background"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
