<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fingerprint_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@android:style/TextAppearance.Large"
        android:gravity="center"
        android:id="@+id/fingerprint"
        android:tag="styles:title;strings:fingerprint_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/nnl_asm_native_fps_title"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.Material.Subhead"
        android:gravity="center"
        android:id="@+id/fingerprint_description"
        android:tag="styles:heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/fingerprint_icon"
            android:tag="images:fingerprint_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/nnl_asm_native_fps_ic"/>
        <TextView
            android:textAppearance="@android:style/TextAppearance.Material.Small"
            android:id="@+id/fingerprint_status"
            android:tag="styles:text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nnl_asm_native_fps_hint"/>
    </LinearLayout>
</LinearLayout>
