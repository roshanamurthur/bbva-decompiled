<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/tap_on_phone_screen_padding_top"
        android:paddingBottom="@dimen/tap_on_phone_screen_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/tap_on_phone_screen_padding_start"
        android:paddingEnd="@dimen/tap_on_phone_screen_padding_end">
        <TextView
            android:textSize="@dimen/tap_on_phone_title_text_size"
            android:textColor="@color/dark_charcoal"
            android:id="@+id/tap_on_phone_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_on_phone_charge_title"
            android:fontFamily="@font/benton_sans_bbva_bold"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/tap_on_phone_cancel"
            android:layout_width="@dimen/tap_on_phone_close_icon_size"
            android:layout_height="@dimen/tap_on_phone_close_icon_size"
            android:src="@drawable/ic_close_black"
            android:contentDescription="@string/tap_on_phone_close_action_content_description"
            app:layout_constraintBottom_toBottomOf="@+id/tap_on_phone_title"
            app:layout_constraintEnd_toEndOf="@+id/tap_on_phone_title"
            app:layout_constraintTop_toTopOf="@+id/tap_on_phone_title"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tap_on_phone_animation"
            android:layout_width="@dimen/tap_on_phone_animation_size"
            android:layout_height="@dimen/tap_on_phone_animation_size"
            android:layout_marginTop="@dimen/space_4x"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_title"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/tap_on_phone_animation"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_subtitle_text_size"
            android:textColor="@color/dark_charcoal"
            android:id="@+id/tap_on_phone_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2x"
            android:text="@string/tap_on_phone_subtitle"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_animation"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_content_text_size"
            android:textColor="@color/dark_charcoal"
            android:id="@+id/tap_on_phone_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1x"
            android:text="@string/tap_on_phone_content"
            android:fontFamily="@font/benton_sans_bbva_book"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_subtitle"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_content_text_size"
            android:textColor="@color/dark_charcoal"
            android:id="@+id/tap_on_phone_sale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4x"
            android:text="@string/tap_on_phone_sale"
            android:fontFamily="@font/benton_sans_bbva_book"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_content"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_sale_amount_text_size"
            android:textColor="@color/dark_charcoal"
            android:id="@+id/tap_on_phone_sale_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_on_phone_sale_amount"
            android:fontFamily="@font/benton_sans_bbva_bold"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_sale"/>
        <ImageView
            android:id="@+id/tap_on_phone_cards"
            android:layout_width="@dimen/tap_on_phone_cards_width"
            android:layout_height="@dimen/tap_on_phone_cards_height"
            android:src="@drawable/tap_on_phone_cards"
            android:contentDescription="@string/tap_on_phone_cards_content_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tap_on_phone_loader"
        android:background="@color/tap_on_phone_loader_background"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/tap_on_phone_loader_animation"
            android:layout_width="@dimen/tap_on_phone_loader_animation_size"
            android:layout_height="@dimen/tap_on_phone_loader_animation_size"
            app:layout_constraintBottom_toTopOf="@+id/tap_on_phone_loader_processing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/spinner_white"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_content_text_size"
            android:textColor="@color/dark_charcoal"
            android:gravity="center"
            android:id="@+id/tap_on_phone_loader_processing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2x"
            android:text="@string/tap_on_phone_loader_processing"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:layout_constraintBottom_toTopOf="@+id/tap_on_phone_loader_message"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_loader_animation"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_content_text_size"
            android:textColor="@color/dark_charcoal"
            android:gravity="center"
            android:id="@+id/tap_on_phone_loader_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2x"
            android:text="@string/tap_on_phone_loader_move_card_away"
            android:fontFamily="@font/benton_sans_bbva_book"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tap_on_phone_loader_processing"/>
        <TextView
            android:textSize="@dimen/tap_on_phone_content_text_size"
            android:textColor="@color/dark_charcoal"
            android:gravity="center"
            android:id="@+id/tap_on_phone_bottom_disclaimer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2x"
            android:text="@string/tap_on_phone_loader_disclaimer"
            android:fontFamily="@font/benton_sans_bbva_book"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.mastercard.sonic.widget.SonicView
        android:id="@+id/sonic_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/visa_branding_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</FrameLayout>
