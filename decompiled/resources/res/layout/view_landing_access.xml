<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:id="@+id/landing_access_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bbva.ui.widget.ClipBox
            android:id="@+id/landing_access_avatar"
            android:visibility="gone"
            android:layout_width="@dimen/landing_access_default_size_image"
            android:layout_height="@dimen/landing_access_default_size_image"
            android:contentDescription="@null"
            android:importantForAccessibility="noHideDescendants"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/landing_user_access_container"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/landing_access_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bbva.ui.widget.BbvaTextView
                android:textSize="@dimen/landing_access_greeting_label_size"
                android:textColor="?attr/text.01.default"
                android:id="@+id/landing_access_greeting"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:customFontName="BentonSans"
                app:customFontStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bbva.ui.widget.BbvaTextView
                android:textSize="@dimen/landing_access_greeting_label_size"
                android:textColor="?attr/text.01.default"
                android:gravity="center_vertical"
                android:id="@+id/landing_access_name"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:customFontName="BentonSans"
                app:customFontStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/landing_access_greeting"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.bbva.ui.widget.BbvaTextView
            android:textSize="@dimen/landing_access_text_size"
            android:textColor="?attr/text.01.default"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/landing_access_extended_greeting"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/landing_access_text_box_height"
            android:layout_marginTop="@dimen/landing_access_margin_xs"
            app:customFontName="BentonSans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/landing_user_access_container"/>
        <com.bbva.ui.widget.BbvaButton
            android:id="@+id/landing_access_link"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/landing_access_extended_greeting"
            style="@style/Widget.BBVA.Button.Link"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/skeleton_access_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="@dimen/landing_access_margin_xl"
        app:layout_constraintBottom_toTopOf="@+id/landing_access_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/landing_access_container"/>
    <com.bbva.ui.widget.BbvaButton
        android:id="@+id/landing_access_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/landing_access_container"
        style="@style/Widget.BBVA.Button.Primary"/>
</merge>
