<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:theme="@style/PreviewBackgroundStyle"
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/documentScanner_previewOverlayStyle"/>
    <com.bbva.cellswidgets.CellsTextView
        android:theme="@style/PreviewTitleStyle"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16"
        android:layout_marginBottom="@dimen/margin_16"
        android:text="@string/title_preview"
        android:layout_marginVertical="@dimen/margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/documentScanner_previewTitleStyle"/>
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/frame_margin_60"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginRight="@dimen/frame_margin_60"
        android:layout_marginBottom="@dimen/dimen_24"
        android:foreground="@drawable/bg_preview_border"
        android:layout_marginHorizontal="@dimen/frame_margin_60"
        android:layout_marginVertical="@dimen/dimen_24"
        app:layout_constraintBottom_toTopOf="@+id/buttonPanel"
        app:layout_constraintDimensionRatio="35:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.bbva.cellswidgets.CellsImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttonPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bbva.cellswidgets.CellsButton
            android:theme="@style/ButtonStyle"
            android:id="@+id/retry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/take_picture_retry"
            android:drawableStart="@drawable/ic_retry"
            android:layout_marginHorizontal="8dp"
            style="?attr/cellsButtonPrimaryStyle"/>
        <com.bbva.cellswidgets.CellsButton
            android:theme="@style/ButtonStyle"
            android:id="@+id/confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/take_picture_confirm"
            android:layout_marginHorizontal="8dp"
            style="?attr/cellsButtonPrimaryStyle"/>
    </LinearLayout>
    <com.bbva.cellswidgets.CellsImageView
        android:id="@+id/close"
        android:layout_width="@dimen/close_button_size"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/margin_8"
        android:contentDescription="@string/take_picture_close"
        android:layout_marginEnd="@dimen/margin_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_close_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
