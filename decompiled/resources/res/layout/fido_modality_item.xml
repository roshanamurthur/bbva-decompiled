<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="level:fido_view"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/item_container"
        android:tag="styles:row_background"
        android:background="@drawable/nnl_round_corner_background"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="76dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_modality_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tint="@color/nnl_icon_tint_color"/>
        <TextView
            android:textColor="@color/nnl_dark_gray_color"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_modality_title"
            android:tag="styles:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"/>
        <Switch
            android:theme="@style/SwitchBaseTheme"
            android:layout_gravity="center"
            android:id="@+id/switch_btn_reg_dereg"
            android:tag="styles:toggle"
            android:background="@drawable/nnl_appsdk_switch_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@drawable/nnl_appsdk_switch_thumb_color"
            android:trackTint="@android:color/transparent"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_add_method"
            android:tag="images:add_reg_icon"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="0x7f08029e"
            android:layout_weight="0.3"
            android:paddingStart="0dp"
            android:paddingEnd="9dp"/>
    </LinearLayout>
    <View
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"/>
    <Button
        android:textColor="@color/nnl_dark_gray_color"
        android:id="@+id/btn_generic_register"
        android:tag="styles:basic_button;strings:fido_register_button"
        android:background="@drawable/nnl_pale_gray_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:text="@string/register_authenticator"/>
</LinearLayout>
