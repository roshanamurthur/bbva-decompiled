<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLDialogTheme"
    android:orientation="vertical"
    android:tag="level:rename_registration_view;styles:dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/title"
        android:tag="styles:heading;strings:rename_registration_title"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nnl_appsdk_plus_rename_reg_dialog_text"/>
    <EditText
        android:textColor="@color/nnl_dark_gray_color"
        android:gravity="start"
        android:id="@+id/et_rename_reg"
        android:tag="styles:input;strings:rename_registration_hint"
        android:background="@drawable/nnl_border_background"
        android:padding="20dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_margin="5dp"
        android:hint="@null"
        android:cursorVisible="true"
        android:inputType="textEmailAddress"
        android:textCursorDrawable="@null"
        android:importantForAutofill="no">
        <requestFocus/>
    </EditText>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_confirm"
            android:tag="styles:prominent_button;strings:rename_reg_button"
            android:background="@drawable/nnl_red_background"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_appsdk_plus_rename"
            android:textAllCaps="false"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_cancel"
            android:tag="styles:main_button;strings:cancel_button"
            android:background="@drawable/nnl_dark_gray_background"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_appsdk_plus_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
</LinearLayout>
