<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bbva.cellswidgets.CellsCircleInitialsView
        android:id="@+id/initialsView"
        style="?attr/cellsMenu_headerAvatarStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bbva.cellswidgets.CellsTextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/headerTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="?attr/cellsMenu_headerTitleTextAppearance"/>
        <com.bbva.cellswidgets.CellsTextView
            android:id="@+id/subHeaderTextView"
            android:layout_width="match_parent"
            style="?attr/cellsMenu_subHeaderTitleTextAppearance"/>
        <com.bbva.cellswidgets.CellsTextView
            android:id="@+id/headerThirdLine"
            android:layout_width="wrap_content"
            style="?attr/cellsMenu_thirdLineTextAppearance"/>
        <com.bbva.cellswidgets.CellsTextView
            android:id="@+id/headerSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/cellsMenu_headerSubtitleTextAppearance"/>
    </LinearLayout>
</LinearLayout>
