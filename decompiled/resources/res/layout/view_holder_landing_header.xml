<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.BBVA.Secondary"
    android:id="@+id/header"
    android:background="?attr/surface.ambient.default"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bbva.glomohybrid.ui.view.OverlayImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:overlay_color="@color/landing_background_overlay"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/shortcuts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop">
        <com.bbva.component.ui.landing.access.LandingAccessView
            android:theme="@style/Theme.BBVA.Secondary"
            android:id="@+id/access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:landingAccessView_imageSize="@dimen/landing_image_default_size"/>
        <com.bbva.component.ui.message.link.MessageLinkView
            android:id="@+id/digital_activation"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:messageLinkView_backgroundColor="@color/transparent"
            app:messageLinkView_buttonText="@string/label_digital_activation_link"
            app:messageLinkView_buttonTextColor="@color/catalog_selector_blue_link_dark"
            app:messageLinkView_icon="@drawable/ic_real_key"
            app:messageLinkView_label="@string/label_digital_activation"/>
        <com.bbva.component.ui.message.card.MessageCardView
            android:id="@+id/blocker_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:messageCardView_forceDarkStyle="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.bbva.component.ui.shortcuts.ShortcutsSimpleView
        android:theme="@style/Theme.BBVA.Secondary"
        android:id="@+id/shortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="411dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_begin="88dp"
        app:layout_constraintStart_toEndOf="@+id/background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
