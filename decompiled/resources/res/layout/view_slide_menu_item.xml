<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bbva.cellswidgets.CellsImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/selectionStateImageView"
        android:background="@drawable/selector_menu_item_icon"
        android:duplicateParentState="true"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iconImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bbva.cellswidgets.CellsImageView
        android:id="@+id/iconImageView"
        android:duplicateParentState="true"
        android:layout_width="?attr/cellsMenuItem_iconSize"
        android:layout_height="?attr/cellsMenuItem_iconSize"
        android:layout_marginRight="?attr/cellsMenuItem_iconMargin"
        android:tint="?attr/cellsMenuItem_iconTint"
        android:layout_marginEnd="?attr/cellsMenuItem_iconMargin"
        app:layout_constraintEnd_toStartOf="@+id/textLabel"
        app:layout_constraintStart_toEndOf="@+id/selectionStateImageView"/>
    <com.bbva.cellswidgets.CellsImageView
        android:id="@+id/iconFeaturedView"
        android:visibility="gone"
        android:layout_width="?attr/cellsMenuItem_iconFeaturedSize"
        android:layout_height="?attr/cellsMenuItem_iconFeaturedSize"
        android:layout_marginBottom="1dp"
        android:src="@drawable/ic_circle_featured"
        android:tint="?attr/cellsMenuItem_iconFeaturedColor"
        app:layout_constraintStart_toStartOf="@+id/iconImageView"
        app:layout_constraintTop_toTopOf="@+id/iconImageView"/>
    <com.bbva.cellswidgets.CellsTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/textLabel"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/cellsMenuItem_iconSize"
        android:maxLines="2"
        android:layout_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconImageView"
        style="?attr/cellsMenuItem_textAppearance"/>
</merge>
