<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLDialogTheme"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="level:yes_no_view;styles:dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/dialog_header"
        android:tag="styles:view_background"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp">
        <TextView
            android:textSize="18sp"
            android:id="@+id/dialog_title"
            android:tag="styles:title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:gravity="center_horizontal"
            android:id="@+id/confirmation_title"
            android:tag="styles:title"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:id="@+id/confirmation_sub_title"
            android:tag="styles:subtitle"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"/>
        <ImageView
            android:id="@+id/image_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"/>
        <RelativeLayout
            android:id="@+id/authorize_button"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@+id/tv_authorize_text"
                android:tag="strings:authorize_button;styles:prominent_button"
                android:background="@drawable/nnl_red_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/nnl_asmsdk_click_to_authorize"
                android:maxLines="2"
                android:paddingStart="20dp"
                android:paddingEnd="56dp"/>
            <ImageView
                android:id="@+id/iv_confirm_start"
                android:tag="images:passkey_icon"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/nnl_passkey_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/iv_confirm"
                android:tag="images:next_button"
                android:background="@android:color/transparent"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f080298"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/decline_button"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/nnl_dark_gray_color"
                android:gravity="center_vertical"
                android:id="@+id/tv_cancel_text"
                android:tag="strings:cancel_button;styles:basic_button"
                android:background="@drawable/nnl_light_gray_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/nnl_asmsdk_click_to_decline"
                android:maxLines="2"
                android:paddingStart="20dp"
                android:paddingEnd="56dp"/>
            <ImageView
                android:tag="images:cancel_button"
                android:background="@android:color/transparent"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="0x7f08028f"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
