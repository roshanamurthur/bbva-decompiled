<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/pay_with_points_modal_windows_background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@drawable/background_pay_with_points_modal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacing_large"
        android:layout_marginRight="@dimen/spacing_large"
        android:minWidth="@dimen/pay_with_points_modal_min_width"
        android:minHeight="@dimen/pay_with_points_modal_min_height"
        android:layout_marginHorizontal="@dimen/spacing_large">
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/titleTextview"
            android:paddingLeft="@dimen/spacing_medium"
            android:paddingRight="@dimen/spacing_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/title_pay_with_points_modal"
            android:paddingHorizontal="@dimen/spacing_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TitlePayWithPoints"/>
        <View
            android:id="@+id/horizontal_divider"
            android:background="@color/transparent_gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_view_stroke"
            android:layout_marginTop="@dimen/pay_with_points_modal_horizontal_divider_margin_top"
            app:layout_constraintTop_toBottomOf="@+id/titleTextview"/>
        <TextView
            android:id="@+id/yesButton"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="@dimen/pay_with_points_modal_button_height"
            android:text="@string/but_yes_pay_with_points"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vertical_divider"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ButtonPayWithPoints"/>
        <View
            android:id="@+id/vertical_divider"
            android:background="@color/transparent_gray"
            android:layout_width="@dimen/divider_view_stroke"
            android:layout_height="@dimen/pay_with_points_modal_button_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/noButton"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="@dimen/pay_with_points_modal_button_height"
            android:text="@string/but_no_pay_with_points"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vertical_divider"
            style="@style/ButtonPayWithPoints"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
