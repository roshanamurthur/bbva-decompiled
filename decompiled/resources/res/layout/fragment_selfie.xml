<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextureView
        android:id="@+id/vd_photo_preview_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <com.dasnano.vdphotoselfiecapture.other.TranslucentLayer
        android:id="@+id/vd_photo_translucent_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dasnano.vdphotoselfiecapture.other.FaceShape
        android:id="@+id/vd_photo_face_oval"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/VeridasMonospaceBold"
        android:textSize="@dimen/vd_photo_document_face_text_size"
        android:typeface="monospace"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        android:id="@+id/vd_photo_countdown_text_view"
        android:background="@color/vd_photo_transparent"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text=""
        android:layout_alignBottom="@+id/vd_photo_face_oval"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:fontFamily="monospace"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/vd_photo_smile_image_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_alignLeft="@+id/vd_photo_countdown_text_view"
        android:layout_alignTop="@+id/vd_photo_countdown_text_view"
        android:layout_alignRight="@+id/vd_photo_countdown_text_view"
        android:layout_alignBottom="@+id/vd_photo_countdown_text_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vd_photo_document_face_text_size"
        android:typeface="monospace"
        android:textStyle="bold"
        android:gravity="start|center_vertical"
        android:id="@+id/landscape_countdown_text_view_left"
        android:background="@color/vd_photo_transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="false"
        android:layout_centerVertical="true"
        android:fontFamily="monospace"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vd_photo_document_face_text_size"
        android:typeface="monospace"
        android:textStyle="bold"
        android:gravity="end|center_vertical"
        android:id="@+id/vd_photo_landscape_countdown_text_view_right"
        android:background="@color/vd_photo_transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:fontFamily="monospace"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/vd_photo_orientation_guide_image_view"
        android:padding="5dp"
        android:visibility="invisible"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="300dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="false"/>
    <ImageView
        android:id="@+id/vd_photo_veridas_logo"
        android:layout_width="75dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/vd_photo_veridas_logo_blue_coral"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/vd_photo_position_or_smile_view"
        android:background="@drawable/vd_photo_rectangle_helper"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="20dp"
        android:minHeight="120dp"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18sp"
            android:gravity="center"
            android:id="@+id/vd_photo_position_or_smile_text_view"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="Roboto"
            android:textAlignment="center"/>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/vd_photo_mask_arrow_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="110dp">
            <ImageView
                android:id="@+id/vd_photo_gifIv"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/vd_photo_gifIv2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/vd_photo_arrow_top"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/vd_photo_arrow_0"
                    android:rotation="90"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/vd_photo_arrow_bottom"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/vd_photo_arrow_0"
                    android:rotation="270"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/vd_photo_arrow_right"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/vd_photo_arrow_0"
                    android:rotation="180"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@+id/vd_photo_arrow_left"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/vd_photo_arrow_0"
                    android:rotation="0"/>
            </FrameLayout>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/vd_photo_secundary_help_text_size"
            android:textColor="@color/vd_photo_secundary_help_gray_color"
            android:gravity="center"
            android:id="@+id/vd_photo_ngas_step_text"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:fontFamily="Roboto"
            android:textAlignment="center"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/vd_photo_tick_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:animateLayoutChanges="true"/>
    <com.dasnano.vdphotoselfiecapture.other.RectangleView
        android:id="@+id/vd_photo_imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
