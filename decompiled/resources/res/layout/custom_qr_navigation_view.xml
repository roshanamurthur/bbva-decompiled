<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/BBVA_NAVY"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:contentInsetStart="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/closeButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_return"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentStart="true"
                app:tint="@color/BBVA_WHITE"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/BBVA_WHITE"
                android:gravity="center"
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/qr_navigation_title"
                android:layout_centerInParent="true"
                android:fontFamily="@font/benton_sans_bbva_book"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbarButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_info"
                android:tint="@color/BBVA_WHITE"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_toEndOf="@+id/toolbarTitle"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/qrMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/qr_navigation_message"
        android:layout_above="@+id/scannerLayout"
        android:layout_below="@+id/toolbar"
        style="@style/QrDescriptionText"/>
    <Space
        android:id="@+id/scannerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scanner_target_size"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomLinear"
        android:layout_below="@+id/scannerLayout">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/catalog_selector_blue_link_dark"
            android:gravity="center"
            android:id="@+id/mainButton"
            android:background="@android:color/transparent"
            android:padding="@dimen/button_padding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/qr_navigation_button"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:textAllCaps="false"
            android:fontFamily="@font/benton_sans_bbva_medium"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottomLinear"
        android:background="@color/BBVA_WHITE"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/leftButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:drawableTopCompat="@drawable/ic_plin"
            style="@style/QrBottomNavigationButton"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/middleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:drawableTopCompat="@drawable/ic_qr"
            style="@style/QrBottomNavigationButton"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rightButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:drawableTopCompat="@drawable/ic_qr"
            style="@style/QrBottomNavigationButton"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
