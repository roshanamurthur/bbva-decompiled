<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/circularFrameLayout"
        android:background="@drawable/ui_bg_btn_row"
        android:focusable="false"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="@dimen/m"
        android:layout_marginRight="@dimen/m"
        android:layout_marginHorizontal="@dimen/m">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <com.bbva.ui.widget.BbvaTextView
        android:gravity="center"
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/s"
        android:layout_marginTop="@dimen/s"
        android:layout_marginRight="@dimen/s"
        android:layout_marginHorizontal="@dimen/s"/>
</merge>
