<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="wrap_content">
    <com.bbva.cellswidgets.CellsTextView
        android:id="@+id/notificationRowTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/GloMo.Notification.Text.Header"/>
    <com.bbva.cellswidgets.CellsTextView
        android:id="@+id/notificationRowDescriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/GloMo.Notification.Text"/>
</merge>
