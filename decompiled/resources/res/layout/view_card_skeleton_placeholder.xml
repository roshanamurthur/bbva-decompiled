<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/message_card_component_margin_m"
    android:paddingRight="@dimen/message_card_component_margin_m"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/message_card_component_margin_m">
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:id="@+id/card_placeholder_image_view"
        android:layout_width="@dimen/message_card_component_image_small_size"
        android:layout_height="@dimen/message_card_component_image_small_size"
        android:layout_marginTop="@dimen/message_card_component_margin_m"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_cardSkeletonPlaceHolder"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:id="@+id/card_placeholder_title_text_view"
        android:layout_width="136dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_l"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_cardSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:id="@+id/card_placeholder_primary_text_view"
        android:layout_width="256dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_m"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_cardSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:id="@+id/card_placeholder_secondary_text_view"
        android:layout_width="192dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_s"
        android:layout_marginBottom="@dimen/message_card_component_margin_m"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_cardSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
</LinearLayout>
