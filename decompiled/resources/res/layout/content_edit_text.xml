<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:background="?attr/cellsEditText_background"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/cellsEditText_height">
        <com.bbva.cellswidgets.CellsTextView
            android:id="@+id/hintTextView"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/cellsEditText_horizontalPadding"
            android:layout_marginTop="?attr/cellsEditText_verticalPadding"
            android:layout_marginBottom="?attr/cellsEditText_verticalPadding"
            android:transformPivotX="0dp"
            android:transformPivotY="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/leftActionButton"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/cellsEditText_hintTextAppearance"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editText"
            android:background="@null"
            android:paddingLeft="?attr/cellsEditText_horizontalPadding"
            android:paddingBottom="2dp"
            android:saveEnabled="false"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:textCursorDrawable="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/leftActionButton"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/cellsEditText_textAppearance"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/leftActionButton"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="0dp"
            android:layout_marginRight="5dp"
            android:src="?attr/cellsEditText_leftActionIcon"
            android:tint="?attr/cellsEditText_leftActionIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/actionButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/actionButton"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="?attr/cellsEditText_rightActionSize"
            android:layout_height="0dp"
            android:layout_marginRight="?attr/cellsEditText_horizontalPadding"
            android:src="?attr/cellsEditText_rightActionIcon"
            android:tint="?attr/cellsEditText_rightActionIconTint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:theme="?attr/cellsEditText_errorTextAppearance"
        android:orientation="horizontal"
        android:id="@+id/errorLayout"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bbva.cellswidgets.CellsImageView
            android:id="@+id/errorImage"
            android:duplicateParentState="true"
            android:layout_width="?attr/cellsEditText_errorIconSize"
            android:layout_height="?attr/cellsEditText_errorIconSize"
            android:src="?attr/cellsEditText_errorIcon"
            android:tint="?attr/cellsEditText_errorIconTint"
            android:layout_marginStart="?attr/cellsEditText_errorHorizontalMargin"/>
        <com.bbva.cellswidgets.CellsTextView
            android:id="@+id/errorLabel"
            android:focusableInTouchMode="true"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="?attr/cellsEditText_errorPadding"
            android:layout_marginEnd="?attr/cellsEditText_errorHorizontalMargin"/>
    </LinearLayout>
</merge>
