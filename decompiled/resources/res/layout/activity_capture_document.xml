<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bbva.document.scanner.presentation.view.FrameBackground
        android:theme="@style/OverlayStyle"
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/documentScanner_overlayStyle"/>
    <com.bbva.document.scanner.presentation.view.FrameView
        android:theme="@style/FrameStyle"
        android:id="@+id/frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/frame_margin_60"
        android:layout_marginTop="@dimen/dimen_24"
        android:layout_marginRight="@dimen/frame_margin_60"
        android:layout_marginBottom="@dimen/dimen_24"
        android:layout_marginHorizontal="@dimen/frame_margin_60"
        android:layout_marginVertical="@dimen/dimen_24"
        app:layout_constraintBottom_toTopOf="@+id/take_photo"
        app:layout_constraintDimensionRatio="35:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="?attr/documentScanner_frameStyle"/>
    <FrameLayout
        android:theme="@style/OverlayStyle"
        android:id="@+id/notificationContainer"
        android:padding="@dimen/dimen_48"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/frame"
        app:layout_constraintEnd_toEndOf="@+id/frame"
        app:layout_constraintStart_toStartOf="@+id/frame"
        app:layout_constraintTop_toTopOf="@+id/frame"
        style="?attr/documentScanner_overlayStyle">
        <com.bbva.cellswidgets.CellsTextView
            android:theme="@style/NotificationTextStyle"
            android:id="@+id/notificationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/documentScanner_notificationTextStyle"/>
    </FrameLayout>
    <com.bbva.cellswidgets.CellsButton
        android:id="@+id/take_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_24"
        android:text="@string/take_picture_make_photo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:theme="@style/ButtonStyle"
        style="?attr/cellsButtonPrimaryStyle"/>
    <com.bbva.cellswidgets.CellsImageView
        android:id="@+id/close"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:layout_width="@dimen/dimen_48"
        android:layout_height="@dimen/dimen_48"
        android:layout_marginTop="@dimen/margin_8"
        android:contentDescription="@string/take_picture_close"
        android:layout_marginEnd="@dimen/margin_8"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_close_24"/>
</androidx.constraintlayout.widget.ConstraintLayout>
