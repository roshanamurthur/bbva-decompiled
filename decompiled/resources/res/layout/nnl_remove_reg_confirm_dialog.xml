<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLDialogTheme"
    android:orientation="vertical"
    android:tag="level:remove_registration_view;styles:dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/message_part_1"
        android:tag="styles:title;strings:remove_registration_description"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nnl_appsdk_plus_remove_registration_desc"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/nnl_prominent_red_color"
        android:gravity="center"
        android:id="@+id/authenticator_name"
        android:tag="styles:subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_confirm"
            android:tag="styles:prominent_button;strings:yes_button"
            android:background="@drawable/nnl_red_background"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_appsdk_plus_yes"
            android:textAllCaps="false"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btn_cancel"
            android:tag="styles:main_button;strings:no_button"
            android:background="@drawable/nnl_dark_gray_background"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_appsdk_plus_no"
            android:textAllCaps="false"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
</LinearLayout>
