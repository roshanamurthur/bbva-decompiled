<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.BBVA.Primary.Alternative"
    android:background="?attr/surface.ambient.default"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:orientation="horizontal"
        android:id="@+id/appBarLayout"
        android:background="?attr/surface.ambient.default"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <com.bbva.cellswidgets.CellsTextView
            android:textSize="18sp"
            android:textColor="?attr/text.01.default"
            android:layout_gravity="center_vertical"
            android:id="@+id/toolbarTitleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_no_commercial_title"
            android:layout_weight="1"
            android:fontFamily="@font/benton_sans_bbva_bold"
            android:layout_marginStart="16dp"/>
        <com.bbva.cellswidgets.CellsImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/icon_close"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close_notification"
            android:tint="?attr/text.01.default"
            android:layout_weight="0"
            android:layout_marginEnd="4dp"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/notificationDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="?attr/surface.ambient.default"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ic_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/img_bbva_logo"
                    app:tint="@color/BBVA_CORE_BLUE"/>
                <com.bbva.cellswidgets.CellsTextView
                    android:textAppearance="@style/GloMo.Notification.Text"
                    android:textSize="24sp"
                    android:layout_gravity="start"
                    android:id="@+id/topNotificationTitleTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="16dp"
                    android:fontFamily="@font/benton_sans_bbva_bold"
                    android:layout_marginHorizontal="16dp"
                    app:flow_horizontalBias="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ic_logo"/>
                <com.bbva.cellswidgets.CellsTextView
                    android:textAppearance="@style/GloMo.Notification.Text"
                    android:textSize="15sp"
                    android:layout_gravity="start"
                    android:id="@+id/topNotificationDateTextView"
                    android:paddingBottom="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:fontFamily="@font/benton_sans_bbva_book_italic"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/topNotificationTitleTextView"/>
                <com.bbva.cellswidgets.CellsTextView
                    android:textAppearance="@style/GloMo.Notification.Text"
                    android:textSize="15sp"
                    android:layout_gravity="start"
                    android:id="@+id/topNotificationDescriptionTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:fontFamily="@font/benton_sans_bbva_book"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/topNotificationDateTextView"/>
                <com.bbva.cellswidgets.CellsTextView
                    android:textAppearance="@style/GloMo.Notification.Text.Amount"
                    android:layout_gravity="start"
                    android:id="@+id/topNotificationAmountTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/topNotificationDescriptionTextView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/timerProgressLayout"
                layout="@layout/view_timer_progress"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notificationDetailList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:nestedScrollingEnabled="false"/>
            <FrameLayout
                android:id="@+id/shortcutsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bbva.component.ui.loader.LoaderSpinnerComponent
                android:id="@+id/loaderSpinnerComponent"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
