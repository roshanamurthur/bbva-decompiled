<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    style="@style/ListOption.Item.Unselected">
    <com.bbva.cellswidgets.CellsImageView
        android:id="@+id/iconImage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ListOption.Item.Icon"/>
    <com.bbva.cellswidgets.CellsCircleInitialsView
        android:id="@+id/iconInitialsImage"
        app:cellsCircleInitialView_bottomColor="@color/blue_40"
        app:cellsCircleInitialView_font="@font/benton_sans_bbva_book"
        app:cellsCircleInitialView_initials="AB"
        app:cellsCircleInitialView_textColor="@color/BBVA_WHITE"
        app:cellsCircleInitialView_topColor="@color/blue_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ListOption.Item.Icon"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/iconBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="iconImage,iconInitialsImage"/>
    <com.bbva.cellswidgets.CellsTextView
        android:id="@+id/title"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_width="0dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconBarrier"
        app:layout_constraintTop_toTopOf="@+id/iconBarrier"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/ListOption.Item.Title.Unselected"/>
    <com.bbva.cellswidgets.CellsTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iconBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconBarrier"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/ListOption.Item.Subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
