<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/BBVA_CORE_BLUE"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:contentInsetStart="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbar_start_button"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_return"
                android:layout_centerVertical="true"
                android:contentDescription="@string/ic_return_des"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentStart="true"
                app:tint="@color/BBVA_WHITE"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/BBVA_WHITE"
                android:gravity="center"
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:fontFamily="@font/benton_sans_bbva_book"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <com.google.android.material.tabs.TabLayout
        android:theme="@style/Theme.AppCompat"
        android:id="@+id/tab_layout"
        android:background="@color/BBVA_DARK_CORE_BLUE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar"
        android:contentDescription="@string/qr_scanner_enroll_tab_des"
        android:elevation="@dimen/enrollment_qr_tab_layout_elevation"
        app:tabIndicatorColor="@color/white"
        app:tabTextAppearance="@style/EnrollTabStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tab_layout">
        <RelativeLayout
            android:id="@+id/scanner_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/enrollment_qr_no_height"
            android:layout_weight="@dimen/enrollment_qr_box">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/qr_code_box_layout"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_linear"
            android:background="@color/BBVA_DARK_CORE_BLUE"
            android:layout_width="match_parent"
            android:layout_height="@dimen/enrollment_qr_no_height"
            android:layout_weight="@dimen/enrollment_qr_info">
            <TextView
                android:textSize="@dimen/enrollment_qr_text_size"
                android:textColor="@color/white"
                android:gravity="center_horizontal"
                android:id="@+id/qr_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/enrollment_qr_margin"
                android:layout_marginTop="@dimen/enrollment_qr_margin"
                android:layout_marginRight="@dimen/enrollment_qr_margin"
                android:lineSpacingExtra="@dimen/enrollment_qr_line_spacing"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
