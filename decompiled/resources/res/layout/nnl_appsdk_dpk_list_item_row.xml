<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLMngRegsLayoutTheme"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="level:manage_regs_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/nnl_light_gray_background"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingTop="15dp"
        android:paddingRight="10dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:id="@+id/list_item_name"
            android:tag="styles:heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/tv_last_used"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:id="@+id/tv_last_used"
            android:tag="styles:text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/list_item_rename_button"
            android:layout_centerVertical="true"/>
        <ImageView
            android:gravity="end|center_vertical"
            android:id="@+id/list_item_rename_button"
            android:tag="images:rename_reg_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="0x7f08027b"
            android:layout_toLeftOf="@+id/list_item_remove_button"
            android:layout_centerVertical="true"
            android:contentDescription="@string/nnl_appsdk_plus_talkback_rename_text"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:gravity="end|center_vertical"
            android:id="@+id/list_item_remove_button"
            android:tag="images:remove_reg_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="0x7f0802bb"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/nnl_appsdk_plus_talkback_delete_text"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/list_dpk_item_delimiter"
        android:background="?attr/nnl_management_delimiter_background"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"/>
</LinearLayout>
