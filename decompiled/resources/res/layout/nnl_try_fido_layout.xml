<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLDialogTheme"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="styles:dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:tag="styles:view_background"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/decline_button"
            android:tag="images:cancel_button"
            android:background="@android:color/transparent"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/nnl_cancel_icon"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:tag="styles:view_background"
        android:background="@android:color/transparent"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:gravity="center_horizontal"
            android:id="@+id/try_fido_title"
            android:tag="styles:title"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:id="@+id/try_fido_sub_title"
            android:tag="styles:subtitle"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/try_fido_button"
            android:tag="images:passkey_icon"
            android:background="@drawable/nnl_dark_gray_background"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:minHeight="60dp"
            android:text="@string/nnl_common_try_passwordless"
            android:drawablePadding="20dp"
            android:textAllCaps="false"
            android:drawableEnd="@drawable/nnl_passkey_icon_layout"/>
    </LinearLayout>
</LinearLayout>
