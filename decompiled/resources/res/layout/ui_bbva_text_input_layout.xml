<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:background="@drawable/ui_bg_bbva_text_input"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <com.bbva.ui.widget.BbvaTextView
                android:textSize="15sp"
                android:textColor="?attr/form.input.placeholder.default"
                android:id="@+id/hintTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:maxLines="1"
                android:singleLine="true"
                android:importantForAccessibility="no"
                android:layout_marginHorizontal="16dp"
                app:customFontStyle="italic"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bbva.ui.widget.BbvaEditText
                android:textSize="15sp"
                android:textColor="?attr/form.input.field_text.default"
                android:gravity="top"
                android:layout_gravity="center_vertical"
                android:id="@+id/editText"
                android:background="@android:color/transparent"
                android:saveEnabled="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="12dp"
                android:textCursorDrawable="@null"
                app:customFontStyle="italic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/clearImageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginRight="16dp"/>
            <ImageView
                android:id="@+id/iconImageView"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="center"
                android:alpha="0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <ImageView
                android:id="@+id/clearImageView"
                android:padding="12dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_cross"
                android:scaleType="center"
                android:alpha="0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iconImageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_goneMarginRight="0dp"/>
            <View
                android:id="@+id/lineView"
                android:background="@drawable/ui_bg_bbva_text_input_line"
                android:layout_width="0dp"
                android:layout_height="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/errorLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:id="@+id/errorImageView"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ui_ic_warning"
                android:importantForAccessibility="no"
                app:tint="?attr/support.error.default"/>
            <com.bbva.ui.widget.BbvaTextView
                android:textSize="12sp"
                android:textColor="?attr/text.01.default"
                android:id="@+id/errorTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:customFontStyle="italic"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/infoLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <ImageView
                android:id="@+id/infoImageView"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ic_info"
                android:importantForAccessibility="no"
                app:tint="?attr/support.info.default"/>
            <com.bbva.ui.widget.BbvaTextView
                android:textSize="12sp"
                android:textColor="?attr/text.01.default"
                android:id="@+id/infoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                app:customFontStyle="italic"/>
        </LinearLayout>
    </LinearLayout>
</merge>
