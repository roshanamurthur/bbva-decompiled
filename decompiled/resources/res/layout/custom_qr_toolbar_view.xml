<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/BBVA_DARK_CORE_BLUE"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:contentInsetStart="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbarStartButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_return"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentStart="true"
                app:tint="@color/BBVA_WHITE"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/BBVA_WHITE"
                android:gravity="center"
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/qr_scanner_payment_title"
                android:layout_centerInParent="true"
                android:fontFamily="@font/benton_sans_bbva_book"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbarEndButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_close_cross"
                android:tint="@color/BBVA_WHITE"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/qrMessage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/qr_toolbar_message"
        android:layout_above="@+id/scannerLayout"
        android:layout_below="@+id/toolbar"
        style="@style/QrDescriptionText"/>
    <Space
        android:id="@+id/scannerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scanner_target_size"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/scannerLayout">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/qrMessageLinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/gallery_title"
            android:layout_marginStart="@dimen/dimen_48"
            android:layout_marginEnd="@dimen/dimen_48"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="@color/catalog_selector_blue_link_dark"
            android:gravity="center"
            android:id="@+id/gallery_title"
            android:background="@color/transparent"
            android:padding="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_gallery_gallery_title"
            android:layout_centerInParent="true"
            android:textAllCaps="false"
            android:fontFamily="@font/benton_sans_bbva_medium"/>
    </RelativeLayout>
</RelativeLayout>
