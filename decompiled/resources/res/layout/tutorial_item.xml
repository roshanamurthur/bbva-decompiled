<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/firstLinear"
    android:background="@drawable/vd_photo_rectangle_helper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentTop="true">
    <ImageView
        android:id="@+id/imagetutorial"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginTop="10dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="20sp"
            android:gravity="center"
            android:id="@+id/tutorialtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:fontFamily="Roboto"
            android:textAlignment="center"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/tutorialsteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/tutorialtitle"
            android:textAlignment="center"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tutorialsteps">
            <Button
                android:gravity="center_vertical"
                android:id="@+id/previousButton"
                android:background="@color/vd_photo_transparent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:textAllCaps="false"
                android:layout_alignParentStart="true"/>
            <Button
                android:gravity="center_vertical"
                android:id="@+id/nextButton"
                android:background="@color/vd_photo_transparent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:textAllCaps="false"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
