<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="level:select_asm_view;styles:view_background"
    android:background="@color/nnl_bgColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/nnl_textColor"
        android:id="@+id/dialog_title"
        android:tag="styles:title;strings:select_asm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/nnl_mfac_uaf_select_auth_method"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"/>
    <View
        android:background="@color/nnl_viewColor"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/dialog_title"/>
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="22sp"
            android:textColor="@color/nnl_textColor"
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:tag="styles:main_button;strings:cancel_button"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/nnl_mfac_uaf_msg_cancel"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/nnl_textColor"
        android:gravity="center"
        android:id="@+id/long_click"
        android:tag="styles:text;strings:select_asm_long_click"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nnl_mfac_uaf_msg_detail_description"
        android:layout_above="@+id/buttons"/>
    <View
        android:background="@color/nnl_viewColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/long_click"/>
    <View
        android:background="@color/nnl_viewColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/long_click"/>
    <ListView
        android:id="@+id/auth_list_view"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="5dp"
        android:divider="@android:color/white"
        android:dividerHeight="1dp"
        android:choiceMode="singleChoice"
        android:layout_above="@+id/long_click"
        android:layout_below="@+id/dialog_title"/>
</RelativeLayout>
