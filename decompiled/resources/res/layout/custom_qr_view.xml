<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/BBVA_NAVY"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:contentInsetStart="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbarStartButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_return"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentStart="true"
                app:tint="@color/BBVA_WHITE"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="16sp"
                android:textColor="@color/BBVA_WHITE"
                android:gravity="center"
                android:id="@+id/toolbarTittle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/qr_scanner_payment_title"
                android:layout_centerInParent="true"
                android:fontFamily="@font/benton_sans_bbva_book"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/toolbarEndButton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_close_cross"
                android:tint="@color/BBVA_WHITE"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/BBVA_WHITE"
        android:gravity="center"
        android:id="@+id/qr_message"
        android:background="@color/BBVA_NAVY_t90"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/qr_scanner_payment_message"
        android:layout_above="@+id/scanner_layout"
        android:layout_below="@+id/toolbar"
        android:fontFamily="@font/benton_sans_bbva_medium"/>
    <RelativeLayout
        android:id="@+id/scanner_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scanner_target_size"
        android:layout_centerInParent="true">
        <View
            android:background="@color/BBVA_NAVY_t90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/imageScanner"/>
        <ImageView
            android:id="@+id/imageScanner"
            android:layout_width="@dimen/scanner_target_size"
            android:layout_height="@dimen/scanner_target_size"
            android:src="@drawable/ic_qr_scanner_target"
            android:layout_centerInParent="true"/>
        <View
            android:background="@color/BBVA_NAVY_t90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageScanner"/>
    </RelativeLayout>
    <View
        android:background="@color/BBVA_NAVY_t90"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_linear"
        android:layout_below="@+id/scanner_layout"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_linear"
        android:background="@color/BBVA_WHITE"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/BBVA_MEDIUM_BLUE"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/qr_tab_button"
            android:background="@android:color/transparent"
            android:padding="@dimen/button_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="@string/qr_scanner_list_button"
            android:drawablePadding="10dp"
            android:textAllCaps="false"
            android:fontFamily="@font/benton_sans_bbva_medium"
            app:drawableTopCompat="@drawable/ic_qr_list_view"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
