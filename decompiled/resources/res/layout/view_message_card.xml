<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/message_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bbva.cellswidgets.CellsTextView
            android:textSize="15sp"
            android:textColor="?attr/messageCardView_textColorSecondary"
            android:gravity="center_vertical"
            android:id="@+id/message_card_title_view"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/message_card_component_margin_l"
            android:fontFamily="@font/benton_sans_bbva_medium"
            android:paddingStart="@dimen/message_card_component_margin_m"
            android:paddingEnd="@dimen/message_card_component_margin_m"/>
        <RelativeLayout
            android:id="@+id/message_card_background"
            android:background="?attr/messageCardView_cardBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/message_card_component_margin_m">
            <com.bbva.cellswidgets.CellsImageView
                android:layout_gravity="end"
                android:id="@+id/message_card_close_view"
                android:paddingTop="@dimen/message_card_component_margin_s"
                android:paddingBottom="@dimen/message_card_component_margin_m"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/component_ui_message_card_ic_cross"
                android:tint="?attr/messageCardView_cardCrossColor"
                android:contentDescription="@string/component_ui_message_card_close_message"
                android:paddingStart="@dimen/message_card_component_margin_m"
                android:paddingEnd="@dimen/message_card_component_margin_s"
                android:layout_alignParentEnd="true"/>
            <com.bbva.cellswidgets.CellsImageView
                android:id="@+id/message_card_image_view"
                android:layout_width="@dimen/message_card_component_image_small_size"
                android:layout_height="@dimen/message_card_component_image_small_size"
                android:layout_marginTop="@dimen/message_card_component_margin_m"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:layout_marginStart="@dimen/message_card_component_margin_m"/>
            <com.bbva.cellswidgets.CellsTextView
                android:textSize="20sp"
                android:textColor="?attr/messageCardView_textColorPrimary"
                android:id="@+id/message_card_primary_text_view"
                android:paddingTop="@dimen/message_card_component_margin_m"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/message_card_image_view"
                android:fontFamily="@font/benton_sans_bbva_medium"
                android:paddingStart="@dimen/message_card_component_margin_m"
                android:paddingEnd="@dimen/message_card_component_margin_m"/>
            <com.bbva.cellswidgets.CellsTextView
                android:textSize="15sp"
                android:textColor="?attr/messageCardView_textColorPrimary"
                android:id="@+id/message_card_secondary_text_view"
                android:paddingTop="@dimen/message_card_component_margin_s"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/message_card_primary_text_view"
                android:lineSpacingExtra="8dp"
                android:fontFamily="@font/benton_sans_bbva_book"
                android:paddingStart="@dimen/message_card_component_margin_m"
                android:paddingEnd="@dimen/message_card_component_margin_m"/>
            <FrameLayout
                android:id="@+id/message_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/message_card_secondary_text_view"
                android:paddingStart="@dimen/message_card_component_margin_m"
                android:paddingEnd="@dimen/message_card_component_margin_m"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/message_card_button_container"
                android:paddingBottom="@dimen/message_card_component_margin_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/message_link"
                android:paddingStart="@dimen/message_card_component_margin_m"
                android:paddingEnd="@dimen/message_card_component_margin_m"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:id="@+id/skeleton_container_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
