<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:padding="@dimen/scratchcard_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/scratchcard_title_modal_label_text_size"
            android:textColor="@color/scratchcard_title_modal_color"
            android:id="@+id/titleModalLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/benton_sans_bbva_bold"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/closeImage"
            android:layout_width="@dimen/scratchcard_close_image_size"
            android:layout_height="@dimen/scratchcard_close_image_size"
            android:contentDescription="@string/scratchcard_close_button_description"
            app:srcCompat="@drawable/ic_close_cross"/>
    </LinearLayout>
    <com.bbva.glomohybrid.infoscreen.scratchCard.view.ScratchcardBackgroundView
        android:layout_gravity="center_horizontal"
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scratchcard_cover_size"
        android:layout_margin="@dimen/scratchcard_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/coverImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scratchcard_cover_size"
        android:layout_margin="@dimen/scratchcard_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <TextView
        android:textSize="@dimen/scratchcard_text_button_text_size"
        android:textColor="@color/scratchcard_text_button_color_active"
        android:layout_gravity="start"
        android:id="@+id/textButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/scratchcard_margin"
        android:layout_marginTop="@dimen/scratchcard_margin"
        android:layout_marginRight="@dimen/scratchcard_margin"
        android:fontFamily="@font/benton_sans_bbva_medium"
        android:layout_marginHorizontal="@dimen/scratchcard_margin"
        app:layout_constraintTop_toBottomOf="@+id/backgroundView"/>
    <Button
        android:enabled="false"
        android:textSize="@dimen/scratchcard_title_button_text_size"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/titleButton"
        android:background="@color/scratchcard_text_button_color_inactive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/scratchcard_margin"
        android:layout_marginRight="@dimen/scratchcard_margin"
        android:layout_marginBottom="@dimen/scratchcard_title_button_margin_bottom"
        android:textAllCaps="false"
        android:fontFamily="@font/benton_sans_bbva_medium"
        android:layout_marginHorizontal="@dimen/scratchcard_margin"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
