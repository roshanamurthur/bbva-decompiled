<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLMngRegsLayoutTheme"
    android:orientation="vertical"
    android:tag="level:manage_regs_view;styles:view_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lyt_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="false">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_list_title"
            android:tag="styles:title;strings:manage_regs_title"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nnl_appsdk_plus_registrations"
            android:layout_weight="3"/>
        <Button
            android:theme="@style/NNLMngRegsButtonStyle"
            android:textSize="16sp"
            android:textColor="@color/nnl_dark_gray_color"
            android:layout_gravity="center"
            android:id="@+id/btnRemoveAll"
            android:tag="styles:basic_button;strings:remove_all_regs_button"
            android:background="@drawable/nnl_light_gray_background"
            android:text="@string/nnl_appsdk_plus_bt_de_register"
            android:layout_weight="2"
            android:textAllCaps="false"
            style="@style/NNLMngRegsButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lyt_top">
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/emptylvTokens"
            android:tag="styles:heading;strings:no_available_regs"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/nnl_appsdk_plus_no_token_found_info2"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ll_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</RelativeLayout>
