<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <RelativeLayout
            android:id="@+id/menu_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/label_menu"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_icon"
                android:duplicateParentState="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ic_menu_no_plus"
                app:tint="@color/catalog_selector_link_complementary_dark"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_dot"
                android:visibility="gone"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:layout_marginStart="5dp"
                app:srcCompat="@drawable/ic_circle_featured"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="10sp"
                android:textColor="@color/catalog_selector_link_complementary_dark"
                android:gravity="center_horizontal"
                android:id="@+id/menu_text"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/label_menu"
                android:maxLines="1"
                android:fontFamily="@font/benton_sans_bbva_medium"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/company_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:src="@drawable/img_bbva_logo"
            android:adjustViewBounds="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"
            app:contentInsetStart="0dp"/>
    </RelativeLayout>
</merge>
