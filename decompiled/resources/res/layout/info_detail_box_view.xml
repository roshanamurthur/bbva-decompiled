<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical">
    <com.bbva.cellswidgets.CellsImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/infoBoxIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="32dp"
        style="@style/Glomo.FullModal.Infobox.Icon"/>
    <com.bbva.cellswidgets.CellsTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/infoBoxDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/Glomo.FullModal.Message"/>
    <com.bbva.cellswidgets.CellsTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/infoBoxLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        style="@style/Glomo.FullModal.Infobox.ActionText"/>
</merge>
