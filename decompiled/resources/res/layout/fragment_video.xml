<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextureView
        android:id="@+id/vd_video_surface_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.dasnano.vdvideoselfiecapture.other.OvalView
        android:id="@+id/vd_video_oval_video_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dasnano.vdvideoselfiecapture.other.RectangleView
        android:id="@+id/vd_video_rectangle_video_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dasnano.vdvideoselfiecapture.other.FaceShapeView
        android:id="@+id/vd_video_face_oval"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/vd_video_image_view_help"
        android:background="@color/vd_video_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="false"
        android:layout_centerHorizontal="false"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/vd_video_white"
        android:id="@+id/vd_video_template_informative_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/vd_video_tick_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:animateLayoutChanges="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:typeface="monospace"
        android:textStyle="bold"
        android:textColor="@color/vd_video_white"
        android:id="@+id/vd_video_countdown_textview"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:fontFamily="monospace"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:typeface="monospace"
        android:textStyle="bold"
        android:textColor="@color/vd_video_white"
        android:id="@+id/vd_video_countdown_textview_left"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:fontFamily="monospace"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:typeface="monospace"
        android:textStyle="bold"
        android:textColor="@color/vd_video_white"
        android:id="@+id/vd_video_countdown_textview_right"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:fontFamily="monospace"/>
    <FrameLayout
        android:id="@+id/vd_video_textview_border"
        android:background="0x7f080314"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="40dp">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/vd_video_green_border"
            android:background="0x7f080315"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/VeridasLabelText"
            android:textSize="24sp"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/vd_video_textView_video_fragment"
            android:background="0x7f080313"
            android:padding="5dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:textAlignment="center"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/vd_video_captured_layout"
        android:background="#000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="24sp"
            android:textColor="@color/vd_video_white"
            android:id="@+id/vd_video_captured_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="100dp"
            android:drawablePadding="10dp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.dasnano.vdvideoselfiecapture.other.DocumentRectangleOrFace
        android:id="@+id/vd_video_rectangle_fixed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"/>
</RelativeLayout>
