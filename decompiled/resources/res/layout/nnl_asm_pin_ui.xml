<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="level:pin_view;styles:view_background"
    android:background="#ececec"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="top"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp">
        <TextView
            android:textSize="20sp"
            android:id="@+id/title"
            android:tag="styles:title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/subTitle"
            android:tag="styles:subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
        <EditText
            android:textSize="25sp"
            android:gravity="center_horizontal"
            android:id="@+id/pinText"
            android:tag="styles:input"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:inputType="numberPassword"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/pinRequirementsText"
            android:tag="styles:text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/pinLengthText"
            android:tag="styles:text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/repeatedText"
            android:tag="styles:text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="15sp"
            android:id="@+id/sequentialText"
            android:tag="styles:text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TableLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:tag="styles:keyboard_background"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TableRow
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_1"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_1"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_2"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_2"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_3"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_3"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="4dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_4"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_4"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_5"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_5"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_6"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_6"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="4dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_7"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_7"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_8"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_8"
                android:layout_weight="1"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_9"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_9"
                android:layout_weight="1"/>
        </TableRow>
        <TableRow
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="4dp"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_backspace"
                android:tag="styles:basic_button;images:clear_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector_delete_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_backspace"
                android:layout_weight="1"
                android:drawableEnd="@drawable/nnl_asm_pin_bck_btn"
                android:paddingStart="0dp"
                android:paddingEnd="40dp"/>
            <Button
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_0"
                android:tag="styles:basic_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_0"
                android:layout_weight="1"/>
            <Button
                android:enabled="false"
                android:textSize="25sp"
                android:textColor="#ffffff"
                android:id="@+id/numeric_keyboard_button_ok"
                android:tag="styles:main_button"
                android:background="@drawable/nnl_asm_pin_number_button_selector_ok_btn"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/nnl_asm_pin_numeric_keyboard_button_ok"
                android:layout_weight="1"
                android:drawableEnd="@drawable/nnl_ok_button"
                android:paddingStart="0dp"
                android:paddingEnd="30dp"/>
        </TableRow>
    </TableLayout>
</RelativeLayout>
