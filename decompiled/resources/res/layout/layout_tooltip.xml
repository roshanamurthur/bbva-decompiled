<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/TooltipTheme"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/tooltip_top_arrow"
        android:layout_width="30dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/tooltip_content"
        app:layout_constraintEnd_toEndOf="@+id/tooltip_content"
        app:layout_constraintStart_toStartOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_up"/>
    <ImageView
        android:id="@+id/tooltip_bottom_arrow"
        android:layout_width="30dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/tooltip_content"
        app:layout_constraintStart_toStartOf="@+id/tooltip_content"
        app:layout_constraintTop_toBottomOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_down"/>
    <ImageView
        android:id="@+id/tooltip_left_arrow"
        android:layout_width="10dp"
        android:layout_height="30dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/tooltip_content"
        app:layout_constraintEnd_toStartOf="@+id/tooltip_content"
        app:layout_constraintTop_toTopOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_left"/>
    <ImageView
        android:id="@+id/tooltip_right_arrow"
        android:layout_width="10dp"
        android:layout_height="30dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/tooltip_content"
        app:layout_constraintStart_toEndOf="@+id/tooltip_content"
        app:layout_constraintTop_toTopOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_right"/>
    <ImageView
        android:id="@+id/tooltip_ne_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/tooltip_content"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow_ne"/>
    <ImageView
        android:id="@+id/tooltip_ni_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_ni"/>
    <ImageView
        android:id="@+id/tooltip_iz_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="@+id/tooltip_content"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow_iz"/>
    <ImageView
        android:id="@+id/tooltip_iza_arrow"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tooltip_content"
        app:srcCompat="@drawable/arrow_iz_a"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tooltip_content"
        android:background="?attr/tooltipBackground"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tooltip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="?attr/titleTextAppearance"/>
        <TextView
            android:id="@+id/tooltip_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tooltip_title"
            style="?attr/bodyTextAppearance"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tooltip_positive_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tooltip_body"
            style="?attr/positiveButtonStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
