<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginRight="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_large"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginVertical="@dimen/spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="start"
            android:id="@+id/titleTextview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_pay_plans_modal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Text.Title"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_button"
            android:layout_width="@dimen/close_button_icon_size"
            android:layout_height="@dimen/close_button_icon_size"
            android:contentDescription="@string/digital_signature_close_button_content_description"
            app:layout_constraintBottom_toBottomOf="@+id/titleTextview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/titleTextview"
            app:srcCompat="@drawable/ic_close_black"
            app:tint="@color/icon_tint_color"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/subtitle_pay_plans_modal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titleTextview"
            style="@style/Text.Subtitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContentPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/pay_plans_background_caption"
            android:padding="@dimen/spacing_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:layout_marginVertical="@dimen/spacing_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvContentPlans">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCaption"
                android:layout_width="@dimen/pay_plans_size_caption"
                android:layout_height="@dimen/pay_plans_size_caption"
                android:layout_marginTop="@dimen/spacing_small"
                android:tint="@color/pay_plans_icon_caption"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_info_caption"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xxlarge"
                android:tint="@color/pay_plans_icon_caption"
                android:text="@string/caption_pay_plans_modal"
                android:lineSpacingExtra="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/ivCaption"
                app:layout_constraintTop_toTopOf="@+id/ivCaption"
                app:srcCompat="@drawable/ic_info_caption"
                style="@style/Text.Body"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:enabled="false"
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digital_signature_continue"
            android:lineSpacingExtra="6sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OpenpayButtonPrimary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/flContainerMessage"
        android:background="@color/background_screen_overlap"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:background="@drawable/background_pay_with_points_modal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_large"
            android:layout_marginRight="@dimen/spacing_large"
            android:minWidth="@dimen/pay_with_points_modal_min_width"
            android:layout_marginHorizontal="@dimen/spacing_large">
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/tvMessage"
                android:paddingLeft="@dimen/spacing_medium"
                android:paddingRight="@dimen/spacing_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/title_pay_plans_alert"
                android:paddingHorizontal="@dimen/spacing_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TitlePayWithPoints"/>
            <View
                android:id="@+id/horizontal_divider"
                android:background="@color/transparent_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_view_stroke"
                android:layout_marginTop="@dimen/margin_top_horizontal_divider_pay_with_plans"
                app:layout_constraintBottom_toTopOf="@+id/yesButton"
                app:layout_constraintTop_toBottomOf="@+id/tvMessage"/>
            <TextView
                android:id="@+id/yesButton"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/pay_with_points_modal_button_height"
                android:text="@string/but_yes_pay_plans_alert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/vertical_divider"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ButtonPayWithPoints"/>
            <View
                android:id="@+id/vertical_divider"
                android:background="@color/transparent_gray"
                android:layout_width="@dimen/divider_view_stroke"
                android:layout_height="@dimen/pay_with_points_modal_button_height"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:id="@+id/noButton"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/pay_with_points_modal_button_height"
                android:text="@string/but_no_pay_plans_alert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/vertical_divider"
                style="@style/ButtonPayWithPoints"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
