<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="level:pending_auths_view;styles:view_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">
    <TextView
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:id="@+id/title"
        android:tag="styles:text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nnl_appsdk_plus_request_to_sign_in"
        android:layout_alignParentTop="true"
        android:layout_marginStart="5dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textColor="@android:color/black"
        android:id="@+id/remaining_time"
        android:tag="styles:text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/nnl_appsdk_plus_remaining_time"
        android:layout_below="@+id/title"
        android:layout_marginStart="5dp"/>
    <TextView
        android:textColor="@android:color/black"
        android:id="@+id/status_code"
        android:tag="styles:text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/nnl_appsdk_plus_status"
        android:layout_below="@+id/remaining_time"
        android:layout_marginStart="5dp"/>
    <Button
        android:textColor="@android:color/white"
        android:id="@+id/approve_button"
        android:tag="strings:pending_auth_approve_button;styles:prominent_button"
        android:background="@drawable/nnl_red_background"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:text="@string/nnl_appsdk_plus_approve"
        android:layout_below="@+id/status_code"
        android:textAllCaps="false"
        android:layout_marginStart="5dp"/>
    <Button
        android:id="@+id/reject_button"
        android:tag="strings:pending_auth_reject_button;styles:basic_button"
        android:background="@drawable/nnl_pale_gray_background"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:text="@string/nnl_appsdk_plus_reject"
        android:layout_below="@+id/status_code"
        android:textAllCaps="false"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/approve_button"/>
    <View
        android:background="@color/nnl_light_gray_color"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/approve_button"/>
</RelativeLayout>
