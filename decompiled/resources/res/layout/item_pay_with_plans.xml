<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/spacing_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatRadioButton
        android:textSize="@dimen/text_size_medium"
        android:textColor="@color/text_body_color"
        android:id="@+id/radioButtonPlans"
        android:paddingLeft="@dimen/spacing_small"
        android:paddingRight="@dimen/spacing_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:button="@drawable/openpay_custom_radio_button"
        android:fontFamily="@font/benton_sans_bbva_book"
        android:paddingHorizontal="@dimen/spacing_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/divider_pay_with_points_modal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_view_stroke"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        android:layout_marginVertical="@dimen/spacing_small"
        app:layout_constraintTop_toBottomOf="@+id/radioButtonPlans"/>
</androidx.constraintlayout.widget.ConstraintLayout>
