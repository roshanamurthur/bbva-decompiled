<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLDialogTheme"
    android:orientation="horizontal"
    android:tag="level:progress_bar_view;styles:view_background"
    android:background="@drawable/nnl_dark_round_corner_background"
    android:padding="20dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:tag="styles:progress_bar"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#ffffff"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/textView"
        android:tag="styles:text;strings:progress_message"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nnl_common_please_wait"
        android:layout_marginStart="10dp"/>
</LinearLayout>
