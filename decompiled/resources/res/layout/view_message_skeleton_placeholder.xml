<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/messageCardView_messageSkeletonBackground"
    android:padding="@dimen/message_card_component_margin_m"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
            android:id="@+id/message_placeholder_header_text_view"
            android:layout_width="104dp"
            android:layout_height="@dimen/message_card_component_skeleton_height"
            android:layout_marginTop="@dimen/message_card_component_margin_s"
            android:layout_alignParentBottom="true"
            app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"
            app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
        <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
            android:id="@+id/message_placeholder_header_link_view"
            android:layout_width="64dp"
            android:layout_height="@dimen/message_card_component_skeleton_height"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"
            app:cellsSkeletonPlaceHolderView_sharpOffsetStart="@dimen/message_card_component_skeleton_sharp"/>
    </RelativeLayout>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:layout_width="@dimen/message_card_component_image_small_size"
        android:layout_height="@dimen/message_card_component_image_small_size"
        android:layout_marginTop="@dimen/message_card_component_margin_m"
        android:adjustViewBounds="true"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:id="@+id/message_placeholder_title_text_view"
        android:layout_width="168dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_l"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:layout_width="288dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_m"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
    <com.bbva.cellswidgets.skeleton.CellsSkeletonPlaceHolderView
        android:layout_width="224dp"
        android:layout_height="@dimen/message_card_component_skeleton_height"
        android:layout_marginTop="@dimen/message_card_component_margin_s"
        app:cellsSkeletonPlaceHolderView_color="?attr/messageCardView_messageSkeletonPlaceHolder"
        app:cellsSkeletonPlaceHolderView_sharpOffsetEnd="@dimen/message_card_component_skeleton_sharp"/>
</LinearLayout>
