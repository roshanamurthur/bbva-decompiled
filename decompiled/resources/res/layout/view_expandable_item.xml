<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:foreground="?android:attr/selectableItemBackground">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bbva.ui.widget.BbvaTextView
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_weight="1"
            style="@style/Modal.Error.Option.Title.Expandable"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_expand"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/link.main.default"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/expandableContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/titleContainer">
        <com.bbva.ui.widget.BbvaTextView
            android:gravity="center_vertical"
            android:id="@+id/description"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            app:customFontStyle="italic"
            style="@style/Modal.Error.Option.Description"/>
        <com.bbva.ui.widget.BbvaButton
            android:id="@+id/optionExpandableButton"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            style="@style/Widget.BBVA.Button.Link"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
