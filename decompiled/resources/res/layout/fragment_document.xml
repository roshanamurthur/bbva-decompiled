<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/vd_document_surface_view_camera"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dasnano.vddocumentcapture.other.TranslucentLayer
        android:id="@+id/vd_document_document_translucent_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dasnano.vddocumentcapture.other.Rectangle
        android:id="@+id/vd_document_rectangle_esp_dni20_fragment_api_less21"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <com.dasnano.vddocumentcapture.other.Arrow
        android:id="@+id/vd_document_arrow_top_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <com.dasnano.vddocumentcapture.other.Arrow
        android:id="@+id/vd_document_arrow_top_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <com.dasnano.vddocumentcapture.other.Arrow
        android:id="@+id/vd_document_arrow_bottom_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <com.dasnano.vddocumentcapture.other.Arrow
        android:id="@+id/vd_document_arrow_bottom_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <com.dasnano.vddocumentcapture.other.DocumentRectangleOrFace
        android:id="@+id/vd_document_document_rectangle_less21"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/vd_document_image_view_help_documents_less21"
        android:background="@color/vd_document_transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="false"
        android:layout_centerHorizontal="false"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/vd_document_document_face_text_size"
        android:gravity="center"
        android:id="@+id/vd_document_help_text_document_less21"
        android:background="@color/vd_document_transparent"
        android:padding="10dp"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:contextClickable="false"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/vd_document_tick_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:animateLayoutChanges="true"/>
    <TextView
        android:textAppearance="@style/VeridasMonospaceBold"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/vd_document_countdown"
        android:visibility="invisible"
        android:layout_width="200dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:fontFamily="monospace"
        android:textAlignment="center"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/vd_document_camera_button_shutter"
        android:background="@drawable/vd_document_round_button"
        android:visibility="gone"
        android:layout_width="0x7f07045f"
        android:layout_height="0x7f07045f"
        android:maxWidth="90dp"
        android:maxHeight="90dp"
        android:minWidth="50dp"
        android:minHeight="50dp"/>
    <com.dasnano.vddocumentcapture.other.LightSpotsView
        android:id="@+id/vd_document_light_spots_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
