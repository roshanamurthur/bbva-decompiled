<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/NNLMngRegsLayoutTheme"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="level:manage_regs_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:tag="styles:row_background"
        android:background="@drawable/nnl_round_corner_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_list_header"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/list_item_name"
                android:tag="styles:heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_toLeftOf="@+id/tv_last_used"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceListItemSmall"
                android:textSize="12sp"
                android:textColor="@android:color/black"
                android:id="@+id/tv_last_used"
                android:tag="styles:text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/list_item_expand_icon"
                android:layout_centerVertical="true"/>
            <ImageView
                android:gravity="end|center_vertical"
                android:id="@+id/list_item_expand_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080279"
                android:layout_toLeftOf="@+id/list_item_rename_button"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"/>
            <ImageView
                android:gravity="end|center_vertical"
                android:id="@+id/list_item_rename_button"
                android:tag="images:rename_reg_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="0x7f08027b"
                android:layout_toLeftOf="@+id/list_item_remove_button"
                android:layout_centerVertical="true"
                android:contentDescription="@string/nnl_appsdk_plus_talkback_rename_text"
                android:layout_marginStart="10dp"/>
            <ImageView
                android:gravity="end|center_vertical"
                android:id="@+id/list_item_remove_button"
                android:tag="images:remove_reg_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="0x7f0802bb"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/nnl_appsdk_plus_talkback_delete_text"
                android:layout_marginStart="10dp"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_dpk_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
