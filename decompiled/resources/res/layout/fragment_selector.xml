<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:paddingLeft="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingRight="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_large"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/spacing_medium">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/background_pay_with_points_modal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/digital_signature_title_text_size"
            android:textColor="@color/dark_charcoal"
            android:gravity="center_vertical"
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/spacing_large"
            android:fontFamily="@font/bento_font"
            app:layout_constraintBottom_toTopOf="@+id/recycler_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/close_button"
            android:layout_width="@dimen/close_button_icon_size"
            android:layout_height="@dimen/close_button_icon_size"
            android:contentDescription="@string/digital_signature_close_button_content_description"
            android:layout_marginEnd="@dimen/spacing_medium"
            app:layout_constraintBottom_toBottomOf="@+id/title_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title_text_view"
            app:srcCompat="@drawable/ic_close_black"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_content"
            android:background="@color/digital_signature_view_background_color"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_large"
            app:layout_constraintBottom_toTopOf="@+id/continue_button"
            app:layout_constraintTop_toBottomOf="@+id/title_text_view"/>
        <Button
            android:enabled="false"
            android:id="@+id/continue_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/digital_signature_continue"
            android:fontFamily="@font/bento_font_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/DigitalSignatureContinueButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
