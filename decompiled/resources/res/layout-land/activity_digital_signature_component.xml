<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_screen"
    android:padding="@dimen/spacing_medium"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/titleTextview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/digital_signature_title_landscape_mode"
        app:layout_constraintBottom_toTopOf="@+id/signature_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Text.Title"/>
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="@dimen/close_button_icon_size"
        android:layout_height="@dimen/close_button_icon_size"
        android:contentDescription="@string/digital_signature_close_button_content_description"
        app:layout_constraintBottom_toBottomOf="@+id/titleTextview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleTextview"
        app:srcCompat="@drawable/ic_close_black"
        app:tint="@color/icon_tint_color"/>
    <mx.openpay.library.ui.component.signature.SignatureView
        android:id="@+id/signature_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_medium"
        app:backgroundColor="@color/digital_signature_view_background_color"
        app:layout_constraintBottom_toTopOf="@+id/buttonsContainer"
        app:layout_constraintTop_toBottomOf="@+id/titleTextview"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/caption_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/signature_view"
        app:layout_constraintEnd_toEndOf="@+id/signature_view"
        app:layout_constraintStart_toStartOf="@+id/signature_view"
        app:layout_constraintTop_toTopOf="@+id/signature_view"
        style="@style/DigitalSignatureCaption">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/digital_signature_caption_image_content_description"
            app:srcCompat="@drawable/il_touch_signature"/>
        <TextView
            android:id="@+id/caption_textview"
            android:padding="@dimen/spacing_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_signature_caption"
            android:lineSpacingExtra="6sp"
            style="@style/Text.Body"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signature_view">
        <Button
            android:id="@+id/clear_button"
            android:layout_width="@dimen/digital_signature_landscape_button_with"
            android:layout_height="wrap_content"
            android:text="@string/digital_signature_delete"
            android:layout_marginEnd="@dimen/spacing_small"
            style="@style/DigitalSignatureClearButton"/>
        <Button
            android:id="@+id/continue_button"
            android:layout_width="@dimen/digital_signature_landscape_button_with"
            android:layout_height="wrap_content"
            android:text="@string/digital_signature_continue"
            android:layout_marginStart="8dp"
            style="@style/DigitalSignatureContinueButton"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
