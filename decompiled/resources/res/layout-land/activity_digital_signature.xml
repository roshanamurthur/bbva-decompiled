<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/dig_sig_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/SignParentLayout"
        android:padding="@dimen/dig_sig_medium_margin_padding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/dig_sig_small_margin_padding">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/dig_sig_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dig_sign_title"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/DigitalSignClearImg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="0x7f080122"
            android:layout_alignParentEnd="true"/>
        <RelativeLayout
            android:id="@+id/DigitalSignLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/DigitalSignClearImg">
            <LinearLayout
                android:id="@+id/DigitalSignButtonLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dig_sig_medium_margin_padding"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true">
                <Button
                    android:enabled="false"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/DeleteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dig_sig_button_height"
                    android:text="@string/dig_sign_step_delete"
                    android:layout_marginEnd="@dimen/dig_sig_small_margin_padding"
                    style="@style/DigSigLinkButton"/>
                <Button
                    android:enabled="false"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/AcceptBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dig_sig_button_height"
                    android:text="@string/dig_sign_continue"
                    style="@style/DigSigPrimaryButton"/>
            </LinearLayout>
            <com.bbva.signaturepad.ui.widget.SignaturePadView
                android:id="@+id/DigitalSignView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/DigitalSignButtonLayout"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/DigitalSignDirectionsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/DigitalSignDirectionsImg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080121"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dig_sig_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dig_sig_medium_margin_padding"
                    android:text="@string/dig_sign_step_directions"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
